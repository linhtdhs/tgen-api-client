<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:tgenapiclient.Models"
        x:Class="tgenapiclient.EnvironmentWindow"
        Title="Manage Environments" Width="800" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E">
    <Grid ColumnDefinitions="250, 4, *">
        <!-- Environments List -->
        <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="10">
            <TextBlock Grid.Row="0" Text="Environments" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="EnvironmentsListBox" Grid.Row="1" Background="#2D2D30" SelectionChanged="EnvironmentsListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AppEnvironment">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0" Spacing="5">
                <Button x:Name="AddEnvButton" Content="+" Click="AddEnvButton_Click" Width="30" HorizontalContentAlignment="Center"/>
                <Button x:Name="RemoveEnvButton" Content="-" Click="RemoveEnvButton_Click" Width="30" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns"/>

        <!-- Variables Editor -->
        <Grid Grid.Column="2" RowDefinitions="Auto, *, Auto" Margin="10" x:Name="VariablesGrid" IsEnabled="False">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <TextBlock Text="Environment Name:" VerticalAlignment="Center"/>
                <TextBox x:Name="EnvNameTextBox" Width="200" TextChanged="EnvNameTextBox_TextChanged"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <ItemsControl x:Name="VariablesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EnvironmentVariable">
                            <Grid ColumnDefinitions="Auto, *, *, Auto" Margin="0,2,0,5">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Key}" Watermark="Key" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="2" Text="{Binding Value}" Watermark="Value" Margin="0,0,5,0"/>
                                <Button Grid.Column="3" Content="X" Click="RemoveVariable_Click" DataContext="{Binding}" Foreground="Red" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            
            <Button Grid.Row="2" Content="Add Variable" Click="AddVariable_Click" Margin="0,10,0,0" HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</Window>
