<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:tgenapiclient.Models"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="tgenapiclient.MainWindow"
        Title="tgenapiclient - HTTP Client" MinWidth="800" MinHeight="600"
        Width="1024" Height="768"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar: URL and Method -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                <ComboBox x:Name="EnvComboBox" Grid.Column="0" Width="150" Margin="0,0,5,0" SelectionChanged="EnvComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AppEnvironment}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ManageEnvButton" Grid.Column="1" Content="⚙" Margin="0,0,10,0" Click="ManageEnvButton_Click"/>
                
                <ComboBox x:Name="MethodComboBox" Grid.Column="2" Width="100" Margin="0,0,10,0" SelectedIndex="0">
                    <ComboBoxItem>GET</ComboBoxItem>
                    <ComboBoxItem>POST</ComboBoxItem>
                    <ComboBoxItem>PUT</ComboBoxItem>
                    <ComboBoxItem>DELETE</ComboBoxItem>
                    <ComboBoxItem>PATCH</ComboBoxItem>
                </ComboBox>
                
                <Border Grid.Column="3" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Background="#1E1E1E" Margin="0,0,10,0" VerticalAlignment="Center" Height="32">
                    <AvaloniaEdit:TextEditor x:Name="UrlEditor" WordWrap="False" FontFamily="Consolas" Background="Transparent" ShowLineNumbers="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="5,5,5,0" Padding="0,2,2,0"/>
                </Border>
                
                <Button x:Name="SendButton" Grid.Column="4" Content="Send" Width="80" Classes="accent" Click="SendButton_Click" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Split Request and Response -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 4, *">
            <!-- Left Pane: Request -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <TabControl Grid.Row="1" Margin="5">
                    <TabItem Header="Headers">
                        <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="2" Background="#1E1E1E">
                            <AvaloniaEdit:TextEditor x:Name="RequestHeadersEditor" WordWrap="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent"/>
                        </Border>
                    </TabItem>
                    <TabItem Header="Body">
                        <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="2" Background="#1E1E1E">
                            <AvaloniaEdit:TextEditor x:Name="RequestBodyEditor" WordWrap="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- Right Pane: Response -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5,10,0" Spacing="15">
                    <TextBlock Text="Status:" Foreground="Gray"/>
                    <TextBlock x:Name="StatusTextBlock" Text="---" FontWeight="Bold" />
                    <TextBlock Text="Time:" Foreground="Gray"/>
                    <TextBlock x:Name="TimeTextBlock" Text="--- ms" FontWeight="Bold" />
                    <TextBlock Text="Size:" Foreground="Gray"/>
                    <TextBlock x:Name="SizeTextBlock" Text="--- B" FontWeight="Bold" />
                </StackPanel>

                <TabControl Grid.Row="1" Margin="5">
                    <TabItem Header="Response">
                        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="2" Background="#282828">
                            <AvaloniaEdit:TextEditor x:Name="ResponseBodyEditor" WordWrap="True" IsReadOnly="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </TabItem>
                    <TabItem Header="Headers">
                        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="2" Background="#282828">
                            <AvaloniaEdit:TextEditor x:Name="ResponseHeadersEditor" WordWrap="True" IsReadOnly="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
