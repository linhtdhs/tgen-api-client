<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:TGenApiClient.Core.Models"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="TGenApiClient.UI.MainWindow"
        Title="tgenapiclient - HTTP Client" MinWidth="800" MinHeight="600"
        Width="1024" Height="768"
        Background="#1E1E1E">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Bar: URL and Method -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10">
            <Grid ColumnDefinitions="Auto, Auto, Auto, Auto, *, Auto">
                <ComboBox x:Name="EnvComboBox" Grid.Column="0" Width="150" Margin="0,0,5,0" SelectionChanged="EnvComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AppEnvironment}">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ManageEnvButton" Grid.Column="1" Content="⚙" Margin="0,0,10,0" Click="ManageEnvButton_Click"/>
                
                <ComboBox x:Name="MethodComboBox" Grid.Column="2" Width="100" Margin="0,0,10,0" SelectedIndex="0">
                    <ComboBoxItem>GET</ComboBoxItem>
                    <ComboBoxItem>POST</ComboBoxItem>
                    <ComboBoxItem>PUT</ComboBoxItem>
                    <ComboBoxItem>DELETE</ComboBoxItem>
                    <ComboBoxItem>PATCH</ComboBoxItem>
                </ComboBox>
                
                <Border Grid.Column="4" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Background="#1E1E1E" Margin="0,0,10,0" VerticalAlignment="Center" Height="32">
                    <AvaloniaEdit:TextEditor x:Name="UrlEditor" WordWrap="False" FontFamily="Consolas" Background="Transparent" ShowLineNumbers="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="5,5,5,0" Padding="0,2,2,0"/>
                </Border>
                
                <Button x:Name="SendButton" Grid.Column="5" Content="Send" Width="80" Classes="accent" Click="SendButton_Click" HorizontalAlignment="Right" HorizontalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area: Split History, Request, and Response -->
        <Grid Grid.Row="1" ColumnDefinitions="250, 4, *, 4, *">
            
            <!-- Far Left Pane: History -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" Margin="5">
                <TextBlock Grid.Row="0" Text="History" FontWeight="Bold" Margin="5,0,0,10" Foreground="LightGray"/>
                <ListBox x:Name="HistoryListBox" Grid.Row="1" Background="#2D2D30" SelectionChanged="HistoryListBox_SelectionChanged" BorderThickness="1" BorderBrush="#444444" CornerRadius="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:HistoryItem}">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding DisplaySummary}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding DisplayTime}" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="ClearHistoryButton" Grid.Row="2" Content="Clear" Click="ClearHistoryButton_Click" Margin="0,10,0,0" HorizontalAlignment="Right" Foreground="IndianRed"/>
            </Grid>

            <!-- Splitter 1 -->
            <GridSplitter Grid.Column="1" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- Center Pane: Request -->
            <Grid Grid.Column="2" RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5,10,0" Spacing="10" HorizontalAlignment="Right">
                    <TextBlock Text="Indent:" Foreground="Gray" VerticalAlignment="Center"/>
                    <ComboBox x:Name="IndentComboBox" Width="110" SelectedIndex="0" SelectionChanged="IndentComboBox_SelectionChanged">
                        <ComboBoxItem Content="2 Spaces" Tag="  " />
                        <ComboBoxItem Content="4 Spaces" Tag="    " />
                        <ComboBoxItem Content="Tabs" Tag="&#x9;" />
                    </ComboBox>
                </StackPanel>

                <TabControl Grid.Row="1" Margin="5,0,5,0">
                    <TabItem Header="Headers">
                        <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="2" Background="#1E1E1E">
                            <AvaloniaEdit:TextEditor x:Name="RequestHeadersEditor" WordWrap="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent"/>
                        </Border>
                    </TabItem>
                    <TabItem Header="Body">
                        <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="2" Background="#1E1E1E">
                            <AvaloniaEdit:TextEditor x:Name="RequestBodyEditor" WordWrap="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent"/>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- Splitter 2 -->
            <GridSplitter Grid.Column="3" Background="#3E3E42" ResizeDirection="Columns"/>

            <!-- Right Pane: Response -->
            <Grid Grid.Column="4" RowDefinitions="Auto, *">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,5,10,10" Spacing="15">
                    <TextBlock Text="Status:" Foreground="Gray"/>
                    <TextBlock x:Name="StatusTextBlock" Text="---" FontWeight="Bold" />
                    <TextBlock Text="Time:" Foreground="Gray"/>
                    <TextBlock x:Name="TimeTextBlock" Text="--- ms" FontWeight="Bold" />
                    <TextBlock Text="Size:" Foreground="Gray"/>
                    <TextBlock x:Name="SizeTextBlock" Text="--- B" FontWeight="Bold" />
                </StackPanel>

                <TabControl Grid.Row="1" Margin="5">
                    <TabItem Header="Response">
                        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="2" Background="#282828">
                            <AvaloniaEdit:TextEditor x:Name="ResponseBodyEditor" WordWrap="True" IsReadOnly="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </TabItem>
                    <TabItem Header="Headers">
                        <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="3" Padding="2" Background="#282828">
                            <AvaloniaEdit:TextEditor x:Name="ResponseHeadersEditor" WordWrap="True" IsReadOnly="True" FontFamily="Consolas" ShowLineNumbers="True" Background="Transparent" BorderThickness="0" />
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
